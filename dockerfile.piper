FROM python:3.12-slim

WORKDIR /app

RUN python3 -m pip install --no-cache-dir 'piper-tts[http]'

COPY scripts/run-piper-http.sh /usr/local/bin/run-piper-http.sh
RUN chmod +x /usr/local/bin/run-piper-http.sh

ENV PIPER_DATA_DIR=/voices
ENV PIPER_DEFAULT_VOICE=en_US-ryan-medium
ENV PIPER_EXTRA_VOICES=es_MX-ald-medium
ENV PIPER_HTTP_HOST=0.0.0.0
ENV PIPER_HTTP_PORT=5000

VOLUME ["/voices"]

CMD ["/usr/local/bin/run-piper-http.sh"]
