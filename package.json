{
  "name": "dimabot",
  "version": "1.0.0",
  "description": "A Twitch Chat bot that will help with commands and moderation on stream",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "nodemon src/server",
    "bot": "nodemon src/bot",
    "server:dev": "cross-env NODE_ENV=development tsx watch src/server/index.ts",
    "bot:dev": "cross-env NODE_ENV=development tsx watch src/bot/index.ts",
    "dev-all": "concurrently \"npm run start\" \"npm run bot\"",
    "test-bot": "cross-env ENVIRONMENT=test nodemon src/bot",
    "build": "tsc",
    "migrate:event-plan-tier": "tsx src/scripts/migrate_event_plan_tier.script.ts"
  },
  "keywords": [
    "Bot",
    "Chat-bot",
    "Twitch",
    "Streams"
  ],
  "author": "CDOM201",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.797.0",
    "@google/genai": "^0.6.1",
    "@polar-sh/sdk": "^0.42.1",
    "@qdrant/qdrant-js": "^1.16.2",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "css": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "gtts": "^0.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.3",
    "mp3-duration": "^1.1.0",
    "multer": "^1.4.5-lts.1",
    "p-limit": "^7.3.0",
    "redis": "^5.10.0",
    "socket.io": "^4.7.5",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.10",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
